# threads from the backend: each gets its own copy of the shared library's
# thread-local, the executable's and the C runtime's state, which a raw clone
# thread has none of

use std.print;
use std.runtime;
use std.sync.atomic;
use std.sync.thread;
use std.types.size.usize;
use posix_threads.backend;

#[library("locals")]
ext fun locals_next() i64;

#[thread]
var own: i64 = 7;

var passed: i64 = 0;

fun worker(arg: *u8) {
    if (own != 7)           { ret; }
    own = arg::usize::i64;
    if (locals_next() != 42) { ret; }
    if (locals_next() != 43) { ret; }
    if (own == arg::usize::i64) { atomic.fetch_add(?passed, 1); }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (locals_next() != 42) { ret 1; }
    var threads: [4]thread.Thread;
    var i:       usize = 0;
    for (i < 4) {
        val spawned: thread.Operation = thread.spawn_with(worker, (i + 1)::*u8, ?threads[i]);
        if (!(sel spawned.ok)) { ret 2; }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        val joined: thread.Operation = thread.join(?threads[i]);
        if (!(sel joined.ok)) { ret 3; }
        i = i + 1;
    }
    if (atomic.load(?passed) != 4) { ret 4; }
    if (locals_next() != 43)       { ret 5; }
    print.println("with the backend: 4 threads ran with their own thread-locals");
    ret 0;
}
